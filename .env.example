# ---------------------------------------------------------------------------
# Cadence — LinkedIn Studio
# Copy this file to .env.local and fill in the values for local development.
# For production, set the same variables in your hosting provider. Only the
# NEXT_PUBLIC_* values are ever sent to the browser.
# ---------------------------------------------------------------------------

# Public URL of this dashboard. Used to build the LinkedIn OAuth redirect URI.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server only. Never prefix with NEXT_PUBLIC_. Used by OAuth callbacks, signed
# media URLs and to trigger the publishing Edge Function.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# The single email address allowed to sign in to this dashboard.
# It must also be present in the public.app_admins table (see README).
ADMIN_EMAIL=you@example.com

# LinkedIn Developer App (https://www.linkedin.com/developers/apps)
# Request the "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect"
# products. Organization (Company/Showcase Page) publishing is optional and needs
# the separately approved Community Management API product.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must match a redirect URL configured on the LinkedIn app, exactly.
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# Space separated OAuth scopes. Start with the member scopes; add the organization
# scopes only after LinkedIn approves the Community Management API for the app:
#   LINKEDIN_SCOPES=openid profile w_member_social r_organization_admin w_organization_social
# Reconnect every profile after changing scopes so new tokens include them.
LINKEDIN_SCOPES=openid profile w_member_social

# LinkedIn API version header. Bump deliberately after checking the changelog.
LINKEDIN_VERSION=202610

# Telegram notifications (optional but recommended). The bot token is server only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true

# How long to keep uploaded media after a successful publish. 48 hours is the default.
MEDIA_RETENTION_HOURS=48
